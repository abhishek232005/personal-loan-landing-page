NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=kuvik_personal_loan
DB_USER=root
DB_PASSWORD=replace-with-your-database-password
DB_CONNECTION_LIMIT=100
DB_SSL=false
DB_SSL_CA_PATH=

# Generate separate 32-byte random hex values for all four secrets.
JWT_SECRET=replace-with-a-unique-64-character-hex-secret
DATA_ENCRYPTION_KEY=replace-with-a-unique-64-character-hex-secret
PHONE_HASH_SECRET=replace-with-a-unique-64-character-hex-secret
OTP_HASH_SECRET=replace-with-a-unique-64-character-hex-secret
CONSENT_VERSION=2026-10

# Enable test mode for local OTP verification without a live SMS provider.
# Keep this OFF in production and use a real provider only when credentials are configured.
SMS_TEST_MODE=true
SMS_PROVIDER=
SMS_API_URL=https://control.msg91.com/api/v5/otp
SMS_API_TOKEN=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=

CRM_DB_HOST=localhost
CRM_DB_PORT=3306
CRM_DB_NAME=kuvik_crm
CRM_DB_USER=
CRM_DB_PASSWORD=
CRM_DB_CONNECTION_LIMIT=5
CRM_DB_SSL=false
CRM_DB_SSL_CA_PATH=
SALES_WEBHOOK_URL=
SALES_WEBHOOK_TOKEN=

TRUST_PROXY_HOPS=0
LOG_LEVEL=info
